{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch STREAM-FDL normal",
      "type": "cppdbg",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },

      "preLaunchTask": "Wait 3s",
      "program": "${workspaceFolder}/STREAM-FDL/build/main",
      "args": [
        "--normal",
        "${workspaceFolder}/STREAM-FDL/example-config.json",
        "2>", "${workspaceFolder}/STREAM-FDL/logs/$(date +'%F-%H-%M')-logging.log",
        // "1>", "${workspaceFolder}/STREAM-FDL/logs/$(date +'%F-%H-%M')-times.log"
      ],
      "cwd": "${workspaceFolder}/STREAM-FDL",
      "environment": [],

      // "stopAtEntry": false,
      // "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Allow SIGHUP",
          "text": "handle SIGHUP nostop pass print",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "Launch STREAM-FDL holistic",
      "type": "cppdbg",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },

      "preLaunchTask": "Wait 3s",
      "program": "${workspaceFolder}/STREAM-FDL/build/main",
      "args": [
        "--holistic",
        "${workspaceFolder}/STREAM-FDL/example-config.json",
        "2>", "${workspaceFolder}/STREAM-FDL/logs/$(date +'%F-%H-%M')-holistic-logging.log",
        // "1>", "${workspaceFolder}/STREAM-FDL/logs/$(date +'%F-%H-%M')-holistic-times.log"
      ],
      "cwd": "${workspaceFolder}/STREAM-FDL",
      "environment": [],

      // "stopAtEntry": false,
      // "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Allow SIGHUP",
          "text": "handle SIGHUP nostop pass print",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "Launch STREAM-DSM",
      "type": "cppdbg",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },

      "program": "${workspaceFolder}/STREAM-DSM/build/datamgmt/datamgmt",
      "cwd": "${workspaceFolder}/STREAM-DSM",
      "environment": [],

      // "stopAtEntry": false,
      // "externalConsole": false,
      "MIMode": "gdb",
    },
    {
      "name": "Launch evaluation",
      "type": "cppdbg",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },

      "preLaunchTask": "Wait 3s",
      "program": "${workspaceFolder}/evaluation/build/irobot_benchmark/irobot_benchmark",
      "args": [
        "--time", "3600",
        "--results-dir", "results/",
        "--topology", "src/ros2-performance/irobot_benchmark/topology/mont_blanc.json"
      ],
      "cwd": "${workspaceFolder}/evaluation",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/home/ubuntu/stream/evaluation/install/composition_benchmark/lib:/home/ubuntu/stream/evaluation/install/performance_test_factory/lib:/home/ubuntu/stream/evaluation/install/irobot_interfaces_plugin/lib:/home/ubuntu/stream/evaluation/install/performance_test/lib:/home/ubuntu/stream/evaluation/install/performance_metrics/lib:/home/ubuntu/stream/evaluation/install/performance_test_msgs/lib:/home/ubuntu/stream/evaluation/install/memory_benchmark/lib:/opt/ros/rolling/opt/zenoh_cpp_vendor/lib:/opt/ros/rolling/opt/gz_math_vendor/lib:/opt/ros/rolling/opt/gz_utils_vendor/lib:/opt/ros/rolling/opt/rviz_ogre_vendor/lib:/opt/ros/rolling/lib/x86_64-linux-gnu:/opt/ros/rolling/opt/gz_cmake_vendor/lib:/opt/ros/rolling/lib:/usr/local/lib"
        }
      ],

      // "stopAtEntry": false,
      // "externalConsole": false,
      "MIMode": "gdb",
    }
  ],
  "compounds": [
    {
      "name": "Launch STREAM normal",
      "preLaunchTask": "STREAM-prelaunnch-task",
      "configurations": [
        "Launch STREAM-FDL normal",
        "Launch STREAM-DSM",
        "Launch evaluation"
      ],
      "stopAll": true,
    },
    {
      "name": "Launch STREAM holistic",
      "preLaunchTask": "STREAM-prelaunnch-task",
      "configurations": [
        "Launch STREAM-FDL holistic",
        "Launch STREAM-DSM",
        "Launch evaluation"
      ],
      "stopAll": true,
    }
  ]
}